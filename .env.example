# ============================================================
# CYBER-RAG configuration
# Copy to .env.local for local development (that file is git-ignored):
#   cp .env.example .env.local
# On Render (or any host) set these as environment variables instead.
# ============================================================

# ------------------------------------------------------------
# GROQ  (free key: https://console.groq.com/keys)
# ------------------------------------------------------------
GROQ_API_KEY=

# Leave empty to let CYBER-RAG pick the best model your key can access.
# Good defaults in 2026: openai/gpt-oss-20b (fast + cheap) or openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-20b

# Tried in order when the primary model is rate limited or unavailable.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,llama-3.1-8b-instant

# Reasoning models (gpt-oss) support low/medium/high. "low" is plenty for
# grounded question answering and keeps answers fast and cheap.
GROQ_REASONING_EFFORT=low

# Max seconds to wait for Groq, and how many times the SDK retries 429/5xx.
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# Set to true only if you want the model id validated during boot.
GROQ_RESOLVE_ON_BOOT=false

# ------------------------------------------------------------
# RETRIEVAL / EMBEDDINGS
# ------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Leave empty to use every available core (set to 1 on small/shared CPUs).
EMBEDDING_THREADS=

# Build the embedding model in the background at boot instead of on first use.
WARMUP_EMBEDDINGS=false

TOP_K_RETRIEVAL=4
MIN_SIMILARITY_SCORE=0.15
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=50
MAX_CONTEXT_TOKENS=3000
MAX_ANSWER_TOKENS=700

# ------------------------------------------------------------
# STORAGE
# Defaults keep everything inside the repository (uploads/, data/).
# On a host with a persistent disk, point these at the mount, e.g.
#   DATA_DIR=/var/data
#   UPLOAD_DIR=/var/data/uploads
#   HF_HOME=/var/data/hf-cache
# ------------------------------------------------------------
DATA_DIR=
UPLOAD_DIR=
HF_HOME=

# ------------------------------------------------------------
# SERVER
# PORT is injected by most hosts (Render sets it automatically).
# ------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH_MB=16
