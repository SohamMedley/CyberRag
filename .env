# NOTE: this file is tracked by git (it only ever contained a placeholder).
# Put your REAL key in .env.local instead - that file is git-ignored and
# overrides this one. On Render, set GROQ_API_KEY in the dashboard.
# ============================================================
# GROQ API CONFIGURATION
# ============================================================

GROQ_API_KEY=gsk_E   # <- placeholder, replace in .env.local

# Current Groq production model
GROQ_MODEL=openai/gpt-oss-20b


# ============================================================
# RAG & EMBEDDING PIPELINE
# ============================================================

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

TOP_K_RETRIEVAL=5

CHUNK_SIZE_WORDS=350

CHUNK_OVERLAP_WORDS=50


# ============================================================
# FLASK SETTINGS
# ============================================================

FLASK_PORT=5000

FLASK_DEBUG=False
